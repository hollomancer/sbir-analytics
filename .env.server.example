# .env.server.example — Tailscale-only self-hosted server profile
#
# Copy to `.env.server` and fill in real secrets. Never commit `.env.server`.
#   cp .env.server.example .env.server
#
# Load it explicitly for the server stack (the Make targets do this for you):
#   docker compose -f docker-compose.server.yml --env-file .env.server --profile server ...
#
# SECURITY: Compose hardcodes every host port to 127.0.0.1. Nothing is
# reachable over the LAN. Tailscale Serve is the only ingress.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=prod
PYTHONUNBUFFERED=1
SERVICE_STARTUP_TIMEOUT=120

# Image coordinates. Use a manifest compatible with the server host's architecture.
IMAGE_NAME=ghcr.io/hollomancer/sbir-analytics
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Compatibility guard — Compose does not interpolate this value, and
# `make server-check` rejects anything other than loopback.
# -----------------------------------------------------------------------------
SERVER_LOOPBACK=127.0.0.1

# Host ports (all hard-bound to 127.0.0.1)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# TLS-terminated Tailscale Serve port for trusted Neo4j operators.
NEO4J_TAILNET_BOLT_ENABLED=false
NEO4J_TAILNET_BOLT_PORT=17687
DAGSTER_PORT=3000

# -----------------------------------------------------------------------------
# Neo4j credentials (used by the tailnet Bolt route; rotate and restrict carefully)
# -----------------------------------------------------------------------------
NEO4J_USER=neo4j
# Required — the compose file fails fast if this is empty.
NEO4J_PASSWORD=change_me
NEO4J_server_memory_heap_max__size=1G
NEO4J_server_memory_heap_initial__size=512M
NEO4J_server_memory_pagecache_size=512M

# -----------------------------------------------------------------------------
# Storage — defaults are repository-local. On the self-hosted server, point these at
# durable host storage (see the server runbook).
# -----------------------------------------------------------------------------
SERVER_DATA_DIR=./data
SERVER_REPORTS_DIR=./reports
SERVER_LOGS_DIR=./logs
SERVER_ARTIFACTS_DIR=./artifacts
SERVER_NEO4J_DIR=./data/neo4j
SERVER_BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Schedule controls (see packages/sbir-analytics/sbir_analytics/definitions.py).
# The heavy daily all-assets schedule stays OFF on the always-on server.
# Enable the weekly core refresh ONLY after a manual run succeeds.
#
# Heavy assets (CET, fiscal, modernbert, USPTO AI extraction) are LOADED so
# their jobs can be triggered by hand, but nothing schedules them. They used to
# run on AWS Batch with more headroom than this host has; measure runtime and
# memory on a manual run before automating any of them. Set this back to false
# if the code server starts hitting its 3G limit.
# -----------------------------------------------------------------------------
DAGSTER_LOAD_HEAVY_ASSETS=true
SBIR_ETL__DAGSTER__SCHEDULES__DAILY_ALL_ASSETS_ENABLED=false
SBIR_ETL__DAGSTER__SCHEDULES__WEEKLY_CORE_REFRESH_ENABLED=false
SBIR_ETL__DAGSTER__SCHEDULES__MONTHLY_NSF_DEFENSE_LINEAGE_REFRESH_ENABLED=false

# Pipeline chaining: each sensor runs a pipeline after its download job
# succeeds. All default to STOPPED; enable after a manual pipeline run works.
SBIR_ETL__DAGSTER__SENSORS__SBIR_PIPELINE_AFTER_DOWNLOAD_ENABLED=false
SBIR_ETL__DAGSTER__SENSORS__USPTO_PIPELINE_AFTER_DOWNLOAD_ENABLED=false
SBIR_ETL__DAGSTER__SENSORS__USASPENDING_PIPELINE_AFTER_DOWNLOAD_ENABLED=false
SBIR_ETL__DAGSTER__SCHEDULES__MONTHLY_PHASE_TRANSITION_ENABLED=false
SBIR_ETL__DAGSTER__SCHEDULES__WEEKLY_AWARDS_REPORT_ENABLED=false
SBIR_ETL__DAGSTER__SENSORS__PHASE_TRANSITION_ARCHIVE_AFTER_ANALYSIS_ENABLED=false
# Weekly core refresh cron (Sundays 03:00 UTC by default).
SBIR_ETL__DAGSTER__SCHEDULES__WEEKLY_CORE_REFRESH_JOB=0 3 * * 0
# NSF defense-lineage refresh cron (8th of the month, 05:00 UTC by default).
SBIR_ETL__DAGSTER__SCHEDULES__MONTHLY_NSF_DEFENSE_LINEAGE_REFRESH_CRON=0 5 8 * *
# Opt in only after downloading the intended Contracts_Full fiscal-year ZIP.
SBIR_ETL__TRANSITION__CONTRACTS__USE_AWARD_ARCHIVE=false

# -----------------------------------------------------------------------------
# NSF SBIR to DoD defense-lineage release
#
# All paths are paths INSIDE the Linux container. Files below SERVER_DATA_DIR
# appear under /app/data; files below SERVER_ARTIFACTS_DIR appear under
# /app/artifacts. The six source-list values are colon-separated (`:`), not
# comma-separated, because the container uses the Linux path separator. Example:
#   /app/data/raw/source-a.zip:/app/data/raw/source-b.zip
# Leave ANALYSIS_DATE empty to use the current UTC date. Pin it for every
# reproducible run. The production output defaults are persistent bind mounts;
# use the dated canary overrides in the self-hosted server runbook for a first run.
# -----------------------------------------------------------------------------
SBIR_ETL__NSF_DEFENSE_LINEAGE__ANALYSIS_DATE=
SBIR_ETL__NSF_DEFENSE_LINEAGE__OUTPUT_DIR=/app/data/processed/nsf_sbir_defense_lineage
SBIR_ETL__NSF_DEFENSE_LINEAGE__SBIR_AWARDS_PATH=/app/data/raw/sbir/award_data.csv
SBIR_ETL__NSF_DEFENSE_LINEAGE__DIRECT_NSF_SOURCES=
SBIR_ETL__NSF_DEFENSE_LINEAGE__NSF_MAX_WORKERS=8
SBIR_ETL__NSF_DEFENSE_LINEAGE__PRIME_API_SNAPSHOTS=
SBIR_ETL__NSF_DEFENSE_LINEAGE__PRIME_API_PARQUETS=
SBIR_ETL__NSF_DEFENSE_LINEAGE__FETCH_PRIME_API=false
SBIR_ETL__NSF_DEFENSE_LINEAGE__PRIME_CONTRACT_ARCHIVES=
SBIR_ETL__NSF_DEFENSE_LINEAGE__PRIME_ARCHIVE_PARQUETS=
SBIR_ETL__NSF_DEFENSE_LINEAGE__SUBAWARD_SOURCES=
SBIR_ETL__NSF_DEFENSE_LINEAGE__MAX_RELEASE_AGE_DAYS=45
SBIR_ETL__NSF_DEFENSE_LINEAGE__GRAPH_OUTPUT=/app/artifacts/sbir-dib-network-explorer/data/network.json

# -----------------------------------------------------------------------------
# Restart policy for always-on operation
# -----------------------------------------------------------------------------
SERVER_RESTART_POLICY=unless-stopped
